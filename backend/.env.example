# =============================================================================
# Kisan Procurement Platform - Backend Environment Variables Configuration
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Local PostgreSQL example: postgresql://postgres:password@localhost:5432/farmer_procurement
# Cloud PostgreSQL example: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_procurement

# JWT Authentication Secret
JWT_SECRET=kisan_procurement_sih_secure_jwt_secret_2026
JWT_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173
